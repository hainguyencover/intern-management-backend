# ============================================================
# INTERN MANAGEMENT BACKEND — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# =====================
# DATABASE
# =====================
DB_URL=jdbc:mysql://localhost:3306/management_intern?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# =====================
# JWT AUTH
# =====================
JWT_SECRET=change-me-in-production-use-at-least-256-bit-key-here!!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# =====================
# SERVER
# =====================
SERVER_PORT=8080

# =====================
# CORS
# =====================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =====================
# MAIL (SMTP)
# =====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# =====================
# OPENAI (AI SERVICE)
# =====================
OPENAI_API_KEY=sk-your-openai-key-here

# =====================
# REDIS CACHE
# =====================
REDIS_HOST=localhost
REDIS_PORT=6379

# =====================
# ELASTICSEARCH (Optional)
# Set to true only if Elasticsearch is running
# =====================
APP_ES_ENABLED=false
ES_URIS=http://localhost:9200

# =====================
# FILE STORAGE
# =====================
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
