# Backend Environment Variables Template

# Server
SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3307/holaho_intern?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# Security
JWT_SECRET=your_jwt_secret_must_be_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads

# Backup
BACKUP_DIR=./backups

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
