# ==============================================
# SECURITY — NEVER COMMIT THESE
# ==============================================
.env
*.env
*.local
*.pem
*.key
*.p12
*.jks
*.pfx
secret/

# ==============================================
# ENVIRONMENT-SPECIFIC CONFIGS (CONTAIN SECRETS)
# ==============================================
src/main/resources/application-dev.yml
src/main/resources/application-prod.yml
src/main/resources/application-dev.properties
src/main/resources/application-prod.properties
# Note: application.yml (base) is safe to commit — no secrets
# Note: application-test.yml may be committed only if it uses H2 (no real secrets)

# ==============================================
# RUNTIME ARTIFACTS
# ==============================================
uploads/
backups/
logs/
*.log
*.log.*

# ==============================================
# JAVA / MAVEN / GRADLE
# ==============================================
target/
node_modules/

# ==============================================
# MISC
# ==============================================
